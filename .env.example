# Minfy Resolve - local-only buildathon configuration
APP_ENV=development
APP_NAME=Minfy Resolve
APP_VERSION=1.0.0
WEB_URL=http://localhost:5173
API_URL=http://localhost:8000
LOG_LEVEL=INFO

# PostgreSQL + pgvector (Docker Compose defaults shown)
POSTGRES_DB=knowledge_platform
POSTGRES_USER=app_user
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgresql+psycopg://app_user:local_password@postgres:5432/knowledge_platform

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-before-starting-the-api
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=knowledge-platform-api
JWT_AUDIENCE=knowledge-platform-web

# Zero-infrastructure AI option (recommended for the buildathon demo)
# Never commit or share a real API key. Put it only in your ignored local .env.
AI_PROVIDER=disabled
NVIDIA_API_KEY=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
NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2.6
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIMENSIONS=2048
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_GENERATION_MAX_TOKENS=700

# Optional Bedrock compatibility (leave disabled for the zero-cost local demo)
AWS_REGION=
AWS_PROFILE=
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_EMBEDDING_PROVIDER=auto
BEDROCK_EMBEDDING_DIMENSIONS=
BEDROCK_EMBEDDINGS_ENABLED=false
BEDROCK_CHAT_MODEL_ID=
BEDROCK_GENERATION_MAX_TOKENS=500

# Search and RAG
# Keyword/exact-error search still works when RAG is false or the AI key is absent.
SEARCH_RESULT_LIMIT=10
SEARCH_RESULT_THRESHOLD=0.42
RAG_ENABLED=false
RAG_MAX_CONTEXT_SOLUTIONS=4

# Uploads
UPLOAD_PROVIDER=local
UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=text/plain,text/markdown,application/pdf

# Browser/API safety
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
VITE_API_URL=http://localhost:8000
