# Application
APP_ENV=development
APP_NAME=Technical Knowledge and Expert Discovery Platform
WEB_URL=http://localhost:5173
API_URL=http://localhost:8000
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector, supplied by Docker Compose in Phase 1)
DATABASE_URL=postgresql+psycopg://app_user:local_password@postgres:5432/knowledge_platform

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-before-starting-the-api
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=knowledge-platform-api
JWT_AUDIENCE=knowledge-platform-web

# Amazon Bedrock (select model IDs available in the chosen AWS Region)
AWS_REGION=
AWS_PROFILE=
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_EMBEDDING_PROVIDER=auto
BEDROCK_EMBEDDING_DIMENSIONS=
BEDROCK_EMBEDDINGS_ENABLED=false
BEDROCK_CHAT_MODEL_ID=
BEDROCK_GENERATION_MAX_TOKENS=500

# Search and RAG
SEARCH_RESULT_LIMIT=10
SEARCH_SIMILARITY_THRESHOLD=0.35
RAG_ENABLED=false
RAG_MAX_CONTEXT_SOLUTIONS=3

# Uploads
UPLOAD_PROVIDER=local
UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=text/plain,text/markdown,application/pdf

# Web/API safety
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
